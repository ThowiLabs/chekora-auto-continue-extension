{
  "manifest_version": 3,
  "name": "Chekora — Continue Editing automático",
  "version": "1.1.0",
  "author": "ThowiLabs",
  "description": "Reconoce y confirma el aviso de sesión interactiva. Incluye diagnóstico local del clic automático.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_title": "Auto Continue Editing",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ]
}
